{
  "name": "ds-language-service",
  "version": "1.7.4",
  "publisher": "rabraghib",
  "displayName": "DarijaScript",
  "description": "DarijaScript highlighting, completions, syntax diagnostics, and formatting.",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:darijascript"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#007ACC",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rabraghib/darijascript"
  },
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "title": "DarijaScript",
      "properties": {
        "darijascript.interpreterPath": {
          "type": "string",
          "default": "darijascript",
          "description": "Path to the updated DarijaScript CLI used for syntax checking and formatting."
        }
      }
    },
    "languages": [
      {
        "id": "darijascript",
        "aliases": [
          "DarijaScript",
          "ds"
        ],
        "extensions": [
          ".ds"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.png",
          "dark": "./images/file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "darijascript",
        "scopeName": "source.darijascript",
        "path": "./syntaxes/darijascript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "darijascript",
        "path": "./snippets/darijascript.json"
      }
    ]
  }
}
