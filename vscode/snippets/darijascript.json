{
  "Print Statement": {
    "prefix": "golih",
    "body": ["golih(${1:\"Hello, World!\"});"],
    "description": "Prints 'Hello, World!' to the console"
  },
  "Variable Declaration": {
    "prefix": "9ayed",
    "body": ["9ayed ${1:myVariable} = ${2:0};"],
    "description": "Creates a new variable named 'myVariable'"
  },
  "Function Declaration": {
    "prefix": "fonksyon",
    "body": ["fonksyon ${1:myFunction}() {", "\t${2:// body...}", "}"],
    "description": "Creates a new function named 'myFunction'"
  },
  "If Statement": {
    "prefix": "ilakan",
    "body": ["ilakan (${1:true}) {", "\t${2:// body...}", "}"],
    "description": "Creates a new if statement"
  },
  "Else Statement": {
    "prefix": "sinn",
    "body": ["sinn {", "\t${1:// body...}", "}"],
    "description": "Creates a new else statement"
  },
  "If Not Statement": {
    "prefix": "ilamakanch",
    "body": ["ilamakanch (${1:false}) {", "\t${2:// body...}", "}"],
    "description": "Creates a new if not statement"
  },
  "While Loop": {
    "prefix": "ma7dBa9i",
    "body": ["ma7dBa9i (${1:true}) {", "\t${2:// body...}", "}"],
    "description": "Creates a new while loop"
  },
  "For Loop": {
    "prefix": "kol",
    "body": [
      "kol (${1:item} f ${2:items}) {",
      "\t${3:// body...}",
      "}"
    ],
    "description": "Loops over list items, dictionary keys, or Unicode characters"
  },
  "Try Catch": {
    "prefix": "jerreb",
    "body": ["jerreb {", "\t${1:// operation...}", "} ched (${2:err}) {", "\tgolih(${2:err});", "}"],
    "description": "Recovers from a runtime error"
  },
  "Closure": {
    "prefix": "closure",
    "body": ["fonksyon(${1:value}) {", "\trjje3 ${2:value};", "}"],
    "description": "Creates an anonymous function with lexical scope"
  },
  "Input Statement": {
    "prefix": "dakhel",
    "body": ["9ayed ${1:myVariable} = dakhel(\"${2:Enter input}\");"],
    "description": "Creates a new input statement"
  },
  "Input Function": {
    "prefix": "dakhel",
    "body": ["dakhel(\"${1:Enter input}\");"],
    "description": "Creates a new input function"
  },
  "Convert to String (rdoString)": {
    "prefix": "rdoString",
    "body": ["rdoString(${1:myVariable});"],
    "description": "Converts 'myVariable' to a string"
  },
  "Convert to Number (rdo3adad)": {
    "prefix": "rdo3adad",
    "body": ["rdo3adad(${1:myVariable});"],
    "description": "Converts 'myVariable' to a number"
  },
  "Convert to Boolean (rdoBooleen)": {
    "prefix": "rdoBooleen",
    "body": ["rdoBooleen(${1:myVariable});"],
    "description": "Converts 'myVariable' to a boolean"
  }
}
